# ════════════════════════════════════════════
#  Hyper-Motion  —  .gitignore
# ════════════════════════════════════════════

# ── SECRETS — NEVER commit these ────────────
.env
.env.*
!.env.example

# ── Runtime databases (per-user) ─────────────
data/*
!data/.gitkeep

# ── Generated media output ───────────────────
output/*
!output/.gitkeep
!output/facebook_media/.gitkeep
!output/quizzes/.gitkeep

# ── Cache ────────────────────────────────────
.cache/*
!.cache/.gitkeep

# ── Python ───────────────────────────────────
__pycache__/
*.pyc
*.pyo
*.pyd
*.egg-info/
dist/
build/
.eggs/
*.egg
*.whl

# ── Virtual environments ──────────────────────
venv/
.venv/
env/
.env_dir/

# ── Testing ───────────────────────────────────
.pytest_cache/
.coverage
htmlcov/

# ── IDE / OS ──────────────────────────────────
.vscode/
.idea/
*.suo
*.user
.DS_Store
Thumbs.db
