# === Hyper Motion — OmniRoute Configuration ===

# OmniRoute Multi-Key Pooling (Comma-separated for auto-rotation across quotas)
# e.g. GEMINI_API_KEYS=key1,key2,key3
GEMINI_API_KEYS=your-gemini-key-1,your-gemini-key-2
GEMINI_API_KEY=your-primary-gemini-key

# Alternate / Free-Tier Providers for Rate Limit Immunity
GROQ_API_KEY=your-groq-api-key-here
OPENROUTER_API_KEY=your-openrouter-api-key-here
OPENAI_API_KEY=your-openai-api-key-here
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Models
GEMINI_MODEL=gemini-3.8-flash
OPENAI_MODEL=gpt-4o-mini
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# OmniRoute Local Proxy (install: npm install -g omniroute)
# Run `omniroute` then open http://localhost:20128, connect providers & create an API key.
# Check each provider's terms of service before connecting accounts.
OMNIROUTE_BASE_URL=http://localhost:20128/v1
OMNIROUTE_API_KEY=your-omniroute-api-key-here
OMNIROUTE_MODEL=auto

# Intelligence APIs (Optional)
YOUTUBE_API_KEY=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=ultimate-content-agent/1.0

# Application & Security
PORT=8500
HOST=0.0.0.0
DASHBOARD_API_KEY=

# Channel & Branding Context
CHANNEL_NAME=Ultimate Tech & Facts
TARGET_AUDIENCE=Tech Enthusiasts & Curiosity Seekers
CONTENT_TONE=Analytical, Engaging, Energetic, Objective

# Autonomous Scheduler
AUTONOMOUS_ENABLED=true
AUTONOMOUS_INTERVAL_MINUTES=60

# Facebook Page & Growth Engine (Meta Graph API)
# Get credentials from https://developers.facebook.com
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_ACCESS_TOKEN=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_GRAPH_VERSION=v21.0
# Set to true to test with simulated page data & sandbox publishing
FACEBOOK_SIMULATION_MODE=false
# Secret token for webhook verification — must match what you set in Facebook Developer Console
FACEBOOK_WEBHOOK_VERIFY_TOKEN=hypermotion_webhook_secret
